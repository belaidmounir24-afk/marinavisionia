        const q = state.wpSearch.trim().toLowerCase();
        const filtered = state.waypoints.filter((wp) => {
          const catOk = state.wpFilter === "all" || wp.category === state.wpFilter;
          const textOk = !q || [wp.id, wp.name, wp.coords, wp.metaValue2, wp.rawType, wp.depthM].some((s) =>
            String(s || "").toLowerCase().includes(q)
          );
          return catOk && textOk;
