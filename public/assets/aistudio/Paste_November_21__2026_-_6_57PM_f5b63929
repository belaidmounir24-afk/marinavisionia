                <div class="flex flex-col min-w-0 pr-2">
                  <div class="flex items-center gap-space-xs flex-wrap">
                    <span class="font-label-coord text-label-coord ${idColor} font-bold">${escapeHtml(wp.id)}</span>
                    <span class="font-label-status text-label-status px-2 py-0.5 rounded ${badgeClass} uppercase font-bold">${escapeHtml(isActive ? "Route Active" : wp.badge)}</span>
                    <span class="font-label-coord text-[10px] text-outline">type:${escapeHtml(wp.rawType || wp.category)}</span>
                  </div>
                  <h2 class="font-headline-sm text-headline-sm text-primary tracking-tight mt-0.5 truncate">${escapeHtml(wp.name)}</h2>
                  <span class="font-label-coord text-label-coord text-on-surface-variant mt-0.5">${escapeHtml(wp.coords)}</span>
                </div>
                <div class="flex flex-col items-end flex-shrink-0">
                  <span class="font-label-telemetry text-label-telemetry ${isActive ? "text-primary-container" : "text-primary"} font-bold tabular-nums">${wp.distanceNm.toFixed(1)} NM</span>
                  <span class="font-label-coord text-label-coord text-on-surface-variant tabular-nums">Cap ${wp.bearing}°</span>
                </div>
              </div>

              <div class="bg-surface-container-low rounded-lg p-space-sm ${isActive ? "pl-3" : ""} grid grid-cols-2 gap-space-xs">
                <div class="flex flex-col">
                  <span class="font-label-status text-label-status uppercase text-on-surface-variant">${escapeHtml(wp.metaLabel1)}</span>
                  <span class="font-label-telemetry text-label-telemetry text-on-surface font-semibold">${escapeHtml(wp.metaValue1)}</span>
                </div>
                <div class="flex flex-col">
                  <span class="font-label-status text-label-status uppercase text-on-surface-variant">${escapeHtml(wp.metaLabel2)}</span>
