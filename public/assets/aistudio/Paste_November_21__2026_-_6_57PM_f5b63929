  <script>
    (function () {
      "use strict";

      const STORAGE_KEY = "marinevision_skikda_v2";
      const VESSEL_LAT = 36.9350;
      const VESSEL_LON = 6.9550;

      const SAMPLE_SKIKDA_CSV = [
        "name,lat,long,depth,type",
        "Rade de Stora - Banc Pelagique,36.9045,6.8860,28,fish",
        "Passe Ile Srigina,36.9012,6.8795,18,anchor",
        "Cap de Fer - Tombant Nord,37.0815,7.1720,46,wreck",
        "Haut-Fond Ras El Hadid,37.0680,7.1450,8.2,restricted",
        "Fosse Golfe de Skikda,36.9850,7.0150,42,fish",
        "Mouillage Anse des Platanes,36.9210,6.8620,11,anchor"
      ].join("\n");

      function escapeHtml(str) {
        return String(str ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function getCardinal(deg) {
        const dirs = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"];
        return dirs[Math.round(((deg % 360) / 22.5)) % 16];
      }

      // Distance (NM) et relèvement (°) depuis la position du navire dans le Golfe de Skikda
      function computeNavVector(lat, lon) {
        const toRad = (d) => (d * Math.PI) / 180;
        const R_NM = 3440.065;
        const dLat = toRad(lat - VESSEL_LAT);
        const dLon = toRad(lon - VESSEL_LON);
        const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(VESSEL_LAT)) * Math.cos(toRad(lat)) * Math.sin(dLon / 2) ** 2;
        const distNm = 2 * R_NM * Math.asin(Math.sqrt(a));
        const y = Math.sin(dLon) * Math.cos(toRad(lat));
        const x = Math.cos(toRad(VESSEL_LAT)) * Math.sin(toRad(lat)) - Math.sin(toRad(VESSEL_LAT)) * Math.cos(toRad(lat)) * Math.cos(dLon);
        const bearing = Math.round(((Math.atan2(y, x) * 180) / Math.PI + 360) % 360);
        return { distNm: +distNm.toFixed(1), bearing };
      }

      function normalizeCsvType(rawType) {
        const t = String(rawType || "").trim().toLowerCase();
        if (/fish|poisson|banc|pelag|peche/.test(t)) return "fish";
        if (/wreck|epave|struct|tombant|recif/.test(t)) return "wreck";
        if (/anchor|mouillage|abri|passe|port/.test(t)) return "anchor";
        if (/restrict|danger|haut|interdit|zone/.test(t)) return "restricted";
        return "fish";
      }

      function buildWaypointFromCsvRow({ name, lat, lon, depth, type, sourceFile }, idx) {
        const cat = normalizeCsvType(type);
        const vec = computeNavVector(lat, lon);
        const id = "WP-" + String(idx).padStart(2, "0");
        const labels = {
          fish: { badge: "Banc IA", l1: "Profondeur Sonar", l2: "Détection Biologique", v2: "Biomasse Détectée", ai: true },
          wreck: { badge: "Structure", l1: "Profondeur Quille", l2: "Nature Fond", v2: "Relief / Structure", ai: false },
          anchor: { badge: "Mouillage", l1: "Sonde Mouillage", l2: "Statut Abri", v2: "Zone Abritée", ai: false },
          restricted: { badge: "Réglementée", l1: "Sonde Critique", l2: "Alerte Sécurité", v2: "Haut-Fond / Restriction", ai: false }
        }[cat];

        return {
          id,
          name: name || `Point Skikda ${idx}`,
          lat,
          lon,
          category: cat,
          rawType: type || cat,
          badge: labels.badge,
          distanceNm: vec.distNm,
          bearing: vec.bearing,
          depthM: depth,
          metaLabel1: labels.l1,
          metaValue1: `${depth} mètres`,
          metaLabel2: labels.l2,
          metaValue2: labels.v2,
          timestamp: `Source : ${sourceFile || "skikda_points.csv"}`,
          coords: `${lat.toFixed(4)}° N / ${lon.toFixed(4)}° E`,
          aiDetected: labels.ai,
          confidence: cat === "fish" ? 94 : 98
        };
      }

      function parseSkikdaCsvText(csvText, sourceFile = "skikda_points.csv") {
        const lines = String(csvText || "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
        if (!lines.length) return [];

        const firstCols = lines[0].toLowerCase().split(/[;,]/).map((c) => c.trim());
        const hasHeader = firstCols.includes("name") || firstCols.includes("lat");
        const colIdx = {
          name: hasHeader ? Math.max(0, firstCols.indexOf("name")) : 0,
          lat: hasHeader ? Math.max(1, firstCols.indexOf("lat")) : 1,
          long: hasHeader ? (firstCols.indexOf("long") >= 0 ? firstCols.indexOf("long") : Math.max(2, firstCols.indexOf("lon"))) : 2,
          depth: hasHeader ? Math.max(3, firstCols.indexOf("depth")) : 3,
          type: hasHeader ? Math.max(4, firstCols.indexOf("type")) : 4
        };

        const rows = [];
        for (let i = hasHeader ? 1 : 0; i < lines.length; i++) {
          const cols = lines[i].split(/[;,]/).map((c) => c.trim());
          if (cols.length < 3) continue;
          const lat = parseFloat(cols[colIdx.lat]);
          const lon = parseFloat(cols[colIdx.long]);
          if (Number.isNaN(lat) || Number.isNaN(lon)) continue;
          const depth = parseFloat(cols[colIdx.depth]) || 20;
          const name = cols[colIdx.name] || `Point ${i}`;
          const type = cols[colIdx.type] || "fish";
          rows.push({ name, lat, lon, depth, type, sourceFile });
        }
        return rows;
      }

      const DEFAULT_CONFIG = {
        region: "Golfe de Skikda (Stora - Cap de Fer)",
        mcp_agent: {
          auto_pilot: true,
          biomass_threshold: 0.82,
          min_cluster_size: 15,
          sonar_beam_angle: 120,
          auto_export_nmea: true,
          export_interval_sec: 5,
          low_power_mode: false,
          process_type: "map_overlay",
          mode: "auto_detect"
        },
        points_navigation: []
      };

      const INITIAL_WAYPOINTS = parseSkikdaCsvText(SAMPLE_SKIKDA_CSV, "skikda_points.csv")
        .map((row, idx) => buildWaypointFromCsvRow(row, idx + 1));

      function loadSavedState() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (e) {
          return null;
        }
      }

      const saved = loadSavedState();
      const state = {
        activeTab: "dashboard-bento",
        telemetry: { sog: 11.8, cog: 68, depth: 38.6, chirpDepth: 42.5, gpuLoad: 42, gpuTemp: 58, latency: 82, bentoLatency: 14, fps: 18 },
        config: saved?.config || JSON.parse(JSON.stringify(DEFAULT_CONFIG)),
        waypoints: Array.isArray(saved?.waypoints) && saved.waypoints.length ? saved.waypoints : INITIAL_WAYPOINTS,
        activeWaypointId: saved?.activeWaypointId || "WP-01",
        wpFilter: "all",
        wpSearch: "",
        wpSortAsc: true,
        cacheSizeMb: typeof saved?.cacheSizeMb === "number" ? saved.cacheSizeMb : 142,
        importHistory: Array.isArray(saved?.importHistory) ? saved.importHistory : [
          { date: "Initialisation", file: "skikda_points.csv", count: 6 }
        ],
        mapModeIndex: 0,
        fishLayerVisible: true,
        measureActive: false,
        measurePoints: [],
        logs: [
          { time: "09:42:15", tag: "TOOL CALL", source: "sonar_fish_locator", detail: "Golfe de Skikda : 2 bancs actifs (Stora / Fosse Nord)" },
          { time: "09:40:02", tag: "SYNC", source: "Config Engine", detail: "visionia_optimization.json prêt pour extraction" }
        ]
      };

      function syncConfigWaypoints() {
        state.config.points_navigation = state.waypoints.map((w) => ({
          id: w.id,
          name: w.name,
          lat: w.lat,
          long: w.lon,
          depth: w.depthM,
          type: w.rawType || w.category
        }));
      }
      syncConfigWaypoints();

      function persistState() {
        syncConfigWaypoints();
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({
            config: state.config,
            waypoints: state.waypoints,
            activeWaypointId: state.activeWaypointId,
            cacheSizeMb: state.cacheSizeMb,
            importHistory: state.importHistory
          }));
        } catch (e) {}
      }

      /* ======================================================================
         TOAST & MODALE
      ====================================================================== */
      let toastTimer = null;
      function showToast(message, icon = "check_circle") {
        const toast = document.getElementById("global-toast");
        document.getElementById("global-toast-msg").textContent = message;
        document.getElementById("global-toast-icon").textContent = icon;
        toast.classList.remove("translate-y-24", "opacity-0", "pointer-events-none");
        toast.classList.add("translate-y-0", "opacity-100");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.add("translate-y-24", "opacity-0", "pointer-events-none");
          toast.classList.remove("translate-y-0", "opacity-100");
        }, 2600);
      }

      const modalBackdrop = document.getElementById("global-modal-backdrop");
      function openModal({ title, icon = "info", bodyHtml, footerButtons = [] }) {
        document.getElementById("modal-title").textContent = title;
        document.getElementById("modal-icon").textContent = icon;
        document.getElementById("modal-body").innerHTML = bodyHtml;
        const footer = document.getElementById("modal-footer");
        footer.innerHTML = "";
        footerButtons.forEach((b) => {
          const el = document.createElement("button");
          el.type = "button";
          el.className = b.className || "px-4 py-2 rounded-lg bg-surface-container-high text-primary text-xs font-bold";
          el.textContent = b.label;
          el.addEventListener("click", () => {
            if (b.onClick) b.onClick();
            if (b.closeOnClick !== false) modalBackdrop.classList.add("hidden");
          });
          footer.appendChild(el);
        });
        modalBackdrop.classList.remove("hidden");
      }
      document.getElementById("modal-close-btn").addEventListener("click", () => modalBackdrop.classList.add("hidden"));
      modalBackdrop.addEventListener("click", (e) => { if (e.target === modalBackdrop) modalBackdrop.classList.add("hidden"); });

      /* ======================================================================
         NAVIGATION ONGLETS
      ====================================================================== */
      const navTabs = document.querySelectorAll(".nav-tab");
      const viewPanels = document.querySelectorAll(".view-panel");
      const ACTIVE_NAV = ["text-primary-container", "shadow-[0_0_16px_rgba(0,242,254,0.25)]", "font-semibold"];
      const INACTIVE_NAV = ["text-on-surface-variant"];

      function switchTab(targetId) {
        state.activeTab = targetId;
        viewPanels.forEach((p) => p.classList.toggle("active", p.id === "view-" + targetId));
        navTabs.forEach((tab) => {
          const match = tab.dataset.target === targetId;
          tab.classList.toggle("font-semibold", match);
          if (match) {
            tab.setAttribute("aria-current", "page");
            tab.classList.remove(...INACTIVE_NAV);
            tab.classList.add(...ACTIVE_NAV);
            document.getElementById("header-subtitle").textContent = tab.dataset.subtitle;
          } else {
            tab.removeAttribute("aria-current");
            tab.classList.remove(...ACTIVE_NAV);
            tab.classList.add(...INACTIVE_NAV);
          }
        });
        window.scrollTo({ top: 0, behavior: "smooth" });
        if (targetId === "carte-sonar") resizeEchogramCanvas();
      }
      navTabs.forEach((tab) => tab.addEventListener("click", () => switchTab(tab.dataset.target)));
      document.getElementById("btn-header-mcp").addEventListener("click", () => switchTab("agent-mcp-config"));

      /* ======================================================================
         JOURNAL & JSON VIEWER
      ====================================================================== */
      function appendLog(tag, source, detail) {
        const time = new Date().toTimeString().split(" ")[0];
        state.logs.unshift({ time, tag, source, detail });
        if (state.logs.length > 35) state.logs.pop();
        renderLogs();
      }

      function renderLogs() {
        const c = document.getElementById("log-container");
        if (!c) return;
        c.innerHTML = state.logs.map((entry) => {
          let cls = "bg-secondary-container/20 text-secondary";
          if (entry.tag === "MCP CMD" || entry.tag === "INFERENCE") cls = "bg-tertiary-container/20 text-tertiary-fixed-dim";
          else if (entry.tag === "SYNC" || entry.tag === "CONFIG") cls = "bg-surface-container-high text-primary";
          return `
            <div class="flex items-start gap-2 p-1.5 rounded hover:bg-surface-container-high/40">
              <span class="font-label-coord text-label-coord text-primary-container flex-shrink-0 mt-0.5 tabular-nums">[${escapeHtml(entry.time)}]</span>
              <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-1">
                  <span class="font-label-status text-label-status px-1 rounded ${cls} uppercase">${escapeHtml(entry.tag)}</span>
                  <span class="font-label-telemetry text-label-telemetry text-primary truncate">${escapeHtml(entry.source)}</span>
                </div>
                <span class="font-label-coord text-label-coord text-on-surface-variant break-words">${escapeHtml(entry.detail)}</span>
              </div>
            </div>
          `;
        }).join("");
      }

      function renderJsonViewer(isDirty = false) {
        syncConfigWaypoints();
        const pre = document.getElementById("json-preview-pre");
        if (pre) {
          pre.textContent = JSON.stringify(state.config, null, 2);
        }
        const badge = document.getElementById("json-sync-badge");
        if (badge) {
          badge.textContent = isDirty ? "MODIFIÉ" : "SYNC RAZ";
          badge.className = "font-label-status text-label-status px-2 py-0.5 rounded " +
            (isDirty ? "bg-tertiary-container/20 text-tertiary-fixed-dim" : "bg-secondary-container/20 text-secondary");
        }
      }

      /* ======================================================================
         CARTE GOLFE DE SKIKDA : PROJECTION MAP_OVERLAY & OUTILS
      ====================================================================== */
      function projectLatLonToSvg(lat, lon) {
        // Emprise : Lon 6.82 -> 7.22 | Lat 36.84 -> 37.12
        const x = Math.max(18, Math.min(382, ((lon - 6.82) / 0.40) * 400));
        const y = Math.max(22, Math.min(438, 460 - ((lat - 36.84) / 0.28) * 460));
        return { x, y };
      }

      function renderMapOverlay() {
        const layer = document.getElementById("map-overlay-waypoints");
        if (!layer) return;

        layer.innerHTML = state.waypoints.map((wp) => {
          if (wp.category === "fish" && !state.fishLayerVisible) return "";
          const { x, y } = projectLatLonToSvg(wp.lat || 36.95, wp.lon || 6.98);
          const isActive = wp.id === state.activeWaypointId;
          let color = "#40dcca";
          if (wp.category === "fish") color = "#ffba38";
          else if (wp.category === "wreck") color = "#00f2fe";
          else if (wp.category === "restricted") color = "#ffb4ab";

          return `
            <g transform="translate(${x.toFixed(1)}, ${y.toFixed(1)})" class="cursor-pointer">
              ${isActive ? `<circle cx="0" cy="0" r="13" stroke="#00f2fe" stroke-dasharray="3 3" stroke-width="1.2" opacity="0.85"></circle>` : ""}
              <circle cx="0" cy="0" r="${wp.category === "fish" ? 5 : 4}" fill="${color}" fill-opacity="0.35"></circle>
              <circle cx="0" cy="0" r="2.6" fill="${color}"></circle>
              <text x="7" y="3" fill="${color}" class="font-label-coord text-[8px]" font-weight="700">${escapeHtml(wp.id)} (${wp.depthM}m)</text>
            </g>
          `;
        }).join("");
      }

      /* ======================================================================
         PIPELINE MCP : /import_data, Extraire JSON, Export Excel
      ====================================================================== */
      function executeExtractJson(triggerDownload = true) {
        persistState();
        renderJsonViewer(false);
        if (triggerDownload) exportJson();
        appendLog("SYNC", "Extraire JSON", `Conversion en visionia_optimization.json (${state.waypoints.length} points)`);
        showToast("Conversion effectuée : visionia_optimization.json", "data_object");
      }

      function executeMcpImportCommand(rawCmd) {
        const cmd = String(rawCmd || "").trim();
        if (!cmd) return;

        if (cmd.startsWith("/extract_json")) {
          executeExtractJson(true);
          return;
        }
        if (cmd.startsWith("/export_xlsx")) {
          exportXlsx();
          appendLog("EXPORT", "MCP Agent", "Sauvegarde Excel donnees_visionia.xlsx générée");
          showToast("Sauvegarde Excel : donnees_visionia.xlsx", "table_view");
          return;
        }
        if (cmd.startsWith("/import_data")) {
          const srcMatch = cmd.match(/--source\s+"([^"]+)"/);
          const procMatch = cmd.match(/--process_type\s+"([^"]+)"/);
          const modeMatch = cmd.match(/--mode\s+"([^"]+)"/);
          const source = srcMatch ? srcMatch[1] : "skikda_points.csv";
          const processType = procMatch ? procMatch[1] : "map_overlay";
          const mode = modeMatch ? modeMatch[1] : "auto_detect";

          state.config.mcp_agent.process_type = processType;
          state.config.mcp_agent.mode = mode;

          const parsedRows = parseSkikdaCsvText(SAMPLE_SKIKDA_CSV, source);
          state.waypoints = parsedRows.map((row, idx) => buildWaypointFromCsvRow(row, idx + 1));
          state.activeWaypointId = state.waypoints[0]?.id || "WP-01";
          state.fishLayerVisible = true;
          document.getElementById("map-overlay-status").textContent = `${processType.toUpperCase()} (${state.waypoints.length} PTS)`;

          persistState();
          renderWaypoints();
          renderMapOverlay();
          renderJsonViewer(false);

          appendLog("MCP CMD", "/import_data", `source="${source}" • process_type="${processType}" • mode="${mode}" -> ${state.waypoints.length} points traités`);
          showToast(`MCP : ${state.waypoints.length} points chargés (${processType})`, "bolt");
          return;
        }

        showToast("Commande inconnue. Essayez /import_data, /extract_json ou /export_xlsx", "info");
      }

      document.getElementById("mcp-cmd-form").addEventListener("submit", (e) => {
        e.preventDefault();
        executeMcpImportCommand(document.getElementById("mcp-cmd-input").value);
      });

      document.getElementById("btn-mcp-act-1").addEventListener("click", () => {
        const cmd = '/import_data --source "skikda_points.csv" --process_type "map_overlay" --mode "auto_detect"';
        document.getElementById("mcp-cmd-input").value = cmd;
        executeMcpImportCommand(cmd);
      });
      document.getElementById("btn-mcp-act-2").addEventListener("click", () => executeExtractJson(true));
      document.getElementById("btn-mcp-act-3").addEventListener("click", () => {
        exportXlsx();
        appendLog("EXPORT", "Action MCP #3", "Sauvegarde donnees_visionia.xlsx générée");
        showToast("Sauvegarde Excel : donnees_visionia.xlsx", "table_view");
      });

      document.getElementById("btn-bento-run-mcp").addEventListener("click", () => {
