      // Échogramme Canvas
      const echogramCanvas = document.getElementById("echogram-canvas");
      const echoCtx = echogramCanvas ? echogramCanvas.getContext("2d") : null;
      let echoPhase = 0;

      function drawEchoCol(x, h, phase) {
        if (!echoCtx) return;
        echoCtx.fillStyle = "#040910";
        echoCtx.fillRect(x, 0, 2, h);
        echoCtx.fillStyle = "rgba(0, 242, 254, 0.25)";
        echoCtx.fillRect(x, 4, 2, 3);
        const thermY = h * 0.34 + Math.sin(phase * 0.08) * 2;
        echoCtx.fillStyle = "rgba(64, 220, 202, 0.5)";
        echoCtx.fillRect(x, thermY, 2, 1.5);
        const cyc = phase % 105;
        if (cyc > 24 && cyc < 58) {
          const t = (cyc - 41) / 17;
          echoCtx.fillStyle = Math.abs(t) < 0.35 ? "#ffb4ab" : "#ffba38";
          echoCtx.fillRect(x, h * 0.58 + t * t * 14, 2, 4);
        }
        const seabedY = h * 0.82 + Math.sin(phase * 0.05) * 3;
        echoCtx.fillStyle = "#ffba38";
        echoCtx.fillRect(x, seabedY, 2, 3);
        echoCtx.fillStyle = "#93000a";
        echoCtx.fillRect(x, seabedY + 3, 2, h - seabedY);
      }

      function resizeEchogramCanvas() {
        if (!echogramCanvas) return;
        const r = echogramCanvas.parentElement.getBoundingClientRect();
        if (r.width > 0 && r.height > 0) {
          echogramCanvas.width = Math.floor(r.width);
          echogramCanvas.height = Math.floor(r.height);
          for (let x = 0; x < echogramCanvas.width; x += 2) {
            drawEchoCol(x, echogramCanvas.height, ++echoPhase);
          }
        }
      }

