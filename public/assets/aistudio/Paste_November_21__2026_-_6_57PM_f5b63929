              <tbody>${state.waypoints.map((w) => `<tr style="border-bottom:1px solid #cbd5e1;"><td>${escapeHtml(w.id)}</td><td>${escapeHtml(w.name)}</td><td>${w.lat}, ${w.lon}</td><td>${w.depthM} m</td><td>${escapeHtml(w.rawType || w.category)}</td><td>${w.distanceNm} NM / ${w.bearing}°</td></tr>`).join("")}</tbody>
