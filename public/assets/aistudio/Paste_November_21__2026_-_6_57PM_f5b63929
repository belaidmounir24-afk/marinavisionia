            config: state.config,
            waypoints: state.waypoints,
            activeWaypointId: state.activeWaypointId,
            cacheSizeMb: state.cacheSizeMb,
            importHistory: state.importHistory
          }));
        } catch (e) {
          // Ignore storage quota / sandbox restrictions silently
        }
      }

