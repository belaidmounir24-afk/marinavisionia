        ]
      };

      /* ======================================================================
         3. TOAST & MODALE UNIVERSELLE
      ====================================================================== */
      let toastTimer = null;
      function showToast(message, icon = "check_circle") {
        const toast = document.getElementById("global-toast");
        const toastMsg = document.getElementById("global-toast-msg");
        const toastIcon = document.getElementById("global-toast-icon");
        if (!toast || !toastMsg || !toastIcon) return;

        toastMsg.textContent = message;
        toastIcon.textContent = icon;
        toast.classList.remove("translate-y-24", "opacity-0", "pointer-events-none");
        toast.classList.add("translate-y-0", "opacity-100");

        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.add("translate-y-24", "opacity-0", "pointer-events-none");
          toast.classList.remove("translate-y-0", "opacity-100");
        }, 2600);
      }

      const modalBackdrop = document.getElementById("global-modal-backdrop");
      const modalTitle = document.getElementById("modal-title");
      const modalIcon = document.getElementById("modal-icon");
      const modalBody = document.getElementById("modal-body");
      const modalFooter = document.getElementById("modal-footer");

      function openModal({ title, icon = "info", bodyHtml, footerButtons = [] }) {
        modalTitle.textContent = title;
        modalIcon.textContent = icon;
        modalBody.innerHTML = bodyHtml;
        modalFooter.innerHTML = "";

        footerButtons.forEach((btnCfg) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = btnCfg.className || "px-4 py-2 rounded-lg bg-surface-container-high text-primary text-xs font-bold";
          btn.textContent = btnCfg.label;
          btn.addEventListener("click", () => {
            if (btnCfg.onClick) btnCfg.onClick();
            if (btnCfg.closeOnClick !== false) closeModal();
          });
          modalFooter.appendChild(btn);
        });

        modalBackdrop.classList.remove("hidden");
      }

      function closeModal() {
        modalBackdrop.classList.add("hidden");
      }

      document.getElementById("modal-close-btn").addEventListener("click", closeModal);
      modalBackdrop.addEventListener("click", (e) => {
        if (e.target === modalBackdrop) closeModal();
      });

      /* ======================================================================
         4. NAVIGATION ENTRE LES 4 ONGLETS
      ====================================================================== */
      const navTabs = document.querySelectorAll(".nav-tab");
      const viewPanels = document.querySelectorAll(".view-panel");
      const headerSubtitle = document.getElementById("header-subtitle");
      const ACTIVE_NAV_CLASSES = ["text-primary-container", "shadow-[0_0_16px_rgba(0,242,254,0.25)]", "font-semibold"];
      const INACTIVE_NAV_CLASSES = ["text-on-surface-variant"];

      function switchTab(targetId) {
        state.activeTab = targetId;

        viewPanels.forEach((panel) => {
          panel.classList.toggle("active", panel.id === "view-" + targetId);
        });

        navTabs.forEach((tab) => {
          const isMatch = tab.dataset.target === targetId;
          if (isMatch) {
            tab.setAttribute("aria-current", "page");
            tab.classList.remove(...INACTIVE_NAV_CLASSES);
            tab.classList.add(...ACTIVE_NAV_CLASSES);
            if (headerSubtitle) headerSubtitle.textContent = tab.dataset.subtitle || "MarineVision AI";
          } else {
            tab.removeAttribute("aria-current");
            tab.classList.remove(...ACTIVE_NAV_CLASSES);
            tab.classList.add(...INACTIVE_NAV_CLASSES);
          }
        });

        window.scrollTo({ top: 0, behavior: "smooth" });
        if (targetId === "carte-sonar") {
          resizeEchogramCanvas();
        }
      }

      navTabs.forEach((tab) => {
        tab.addEventListener("click", () => switchTab(tab.dataset.target));
      });

      document.getElementById("btn-header-mcp").addEventListener("click", () => {
        switchTab("agent-mcp-config");
        showToast("Console Agent MCP ouverte", "smart_toy");
      });

      /* ======================================================================
         5. JOURNAL MCP & RENDERING CONFIGURATION
      ====================================================================== */
      function appendLog(tag, source, detail) {
        const now = new Date();
        const timeStr = now.toTimeString().split(" ")[0];
        state.logs.unshift({ time: timeStr, tag, source, detail });
        if (state.logs.length > 30) state.logs.pop();
        renderLogs();
      }

      function renderLogs() {
        const container = document.getElementById("log-container");
        if (!container) return;

        container.innerHTML = state.logs.map((entry) => {
          let badgeClass = "bg-secondary-container/20 text-secondary";
          if (entry.tag === "ROUTING" || entry.tag === "INFERENCE") {
            badgeClass = "bg-tertiary-container/20 text-tertiary-fixed-dim";
          } else if (entry.tag === "SYNC" || entry.tag === "CONFIG") {
            badgeClass = "bg-surface-container-high text-primary";
          }
          return `
            <div class="flex items-start gap-2 p-1.5 rounded hover:bg-surface-container-high/40 transition-colors">
              <span class="font-label-coord text-label-coord text-primary-container flex-shrink-0 mt-0.5 tabular-nums">[${escapeHtml(entry.time)}]</span>
              <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-1">
                  <span class="font-label-status text-label-status px-1 rounded ${badgeClass} uppercase">${escapeHtml(entry.tag)}</span>
                  <span class="font-label-telemetry text-label-telemetry text-primary truncate">${escapeHtml(entry.source)}</span>
                </div>
                <span class="font-label-coord text-label-coord text-on-surface-variant break-words">${escapeHtml(entry.detail)}</span>
              </div>
            </div>
          `;
        }).join("");
      }

      function renderJsonViewer(isDirty = false) {
        const pre = document.getElementById("json-preview-pre");
        const cfg = state.config.mcp_agent;
        if (pre) {
          pre.innerHTML = `<span class="text-on-surface-variant">{</span>
  <span class="text-primary-container">"mcp_agent"</span>: <span class="text-on-surface-variant">{</span>
    <span class="text-primary-container">"auto_pilot"</span>: <span class="${cfg.auto_pilot ? "text-secondary" : "text-error"}">${cfg.auto_pilot}</span>,
    <span class="text-primary-container">"biomass_threshold"</span>: <span class="text-tertiary-fixed-dim">${cfg.biomass_threshold.toFixed(2)}</span>,
    <span class="text-primary-container">"min_cluster_size"</span>: <span class="text-tertiary-fixed-dim">${cfg.min_cluster_size}</span>,
    <span class="text-primary-container">"sonar_beam_angle"</span>: <span class="text-tertiary-fixed-dim">${cfg.sonar_beam_angle}</span>,
    <span class="text-primary-container">"auto_export_nmea"</span>: <span class="${cfg.auto_export_nmea ? "text-secondary" : "text-error"}">${cfg.auto_export_nmea}</span>,
    <span class="text-primary-container">"export_interval_sec"</span>: <span class="text-tertiary-fixed-dim">${cfg.export_interval_sec}</span>,
    <span class="text-primary-container">"low_power_mode"</span>: <span class="${cfg.low_power_mode ? "text-tertiary-fixed-dim" : "text-secondary"}">${cfg.low_power_mode}</span>
  <span class="text-on-surface-variant">}</span>
<span class="text-on-surface-variant">}</span>`;
        }

        const badgeAuto = document.getElementById("badge-autopilot");
        if (badgeAuto) {
          badgeAuto.textContent = cfg.auto_pilot ? "TRUE" : "FALSE";
          badgeAuto.className = "font-label-status text-label-status " + (cfg.auto_pilot ? "text-secondary" : "text-error");
        }

        const badgeNmea = document.getElementById("badge-nmea");
        if (badgeNmea) {
          badgeNmea.textContent = cfg.auto_export_nmea ? "TRUE" : "FALSE";
          badgeNmea.className = "font-label-status text-label-status " + (cfg.auto_export_nmea ? "text-secondary" : "text-error");
        }

        const syncBadge = document.getElementById("json-sync-badge");
        if (syncBadge) {
          if (isDirty) {
            syncBadge.textContent = "NON SAUVÉ";
            syncBadge.className = "font-label-status text-label-status px-2 py-0.5 rounded bg-tertiary-container/20 text-tertiary-fixed-dim";
          } else {
            syncBadge.textContent = "SYNC RAZ";
            syncBadge.className = "font-label-status text-label-status px-2 py-0.5 rounded bg-secondary-container/20 text-secondary";
          }
        }
      }

      /* ======================================================================
         6. BENTO DASHBOARD : SONAR ROTATIF & ACTIONS
      ====================================================================== */
      let radarAngle = 0;
      const sonarBeamEl = document.getElementById("sonar-beam");
      function animateRadar() {
        const step = state.config.mcp_agent.low_power_mode ? 0.55 : 1.25;
        radarAngle = (radarAngle + step) % 360;
        if (sonarBeamEl) {
          sonarBeamEl.style.transform = "rotate(" + radarAngle.toFixed(1) + "deg)";
        }
        requestAnimationFrame(animateRadar);
      }
      requestAnimationFrame(animateRadar);

      document.querySelectorAll(".sonar-blip").forEach((blip) => {
