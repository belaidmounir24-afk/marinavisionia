      // Import CSV (name, lat, long, depth, type) ou GPX
      document.getElementById("import-input").addEventListener("change", (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          const text = String(reader.result || "");
          let newWpts = [];

          if (file.name.toLowerCase().endsWith(".gpx")) {
            const doc = new DOMParser().parseFromString(text, "application/xml");
            doc.querySelectorAll("wpt").forEach((node, i) => {
              const lat = parseFloat(node.getAttribute("lat") || "36.93");
              const lon = parseFloat(node.getAttribute("lon") || "6.95");
              const name = node.querySelector("name")?.textContent?.trim() || `GPX-${i + 1}`;
              newWpts.push(buildWaypointFromCsvRow({ name, lat, lon, depth: 24, type: "anchor", sourceFile: file.name }, state.waypoints.length + i + 1));
            });
          } else {
            const rows = parseSkikdaCsvText(text, file.name);
            newWpts = rows.map((r, i) => buildWaypointFromCsvRow(r, state.waypoints.length + i + 1));
          }

          if (!newWpts.length) {
            showToast("Format invalide : vérifiez les colonnes name, lat, long, depth, type", "warning");
          } else {
            state.waypoints = [...newWpts, ...state.waypoints];
            state.importHistory.unshift({
              date: new Date().toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" }),
