      /* ----- ÉCHOGRAMME WATERFALL CANVAS TEMPS RÉEL ----- */
      const echogramCanvas = document.getElementById("echogram-canvas");
      const echoCtx = echogramCanvas ? echogramCanvas.getContext("2d") : null;
      let echoPhase = 0;

      function resizeEchogramCanvas() {
        if (!echogramCanvas) return;
        const rect = echogramCanvas.parentElement.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          echogramCanvas.width = Math.floor(rect.width);
          echogramCanvas.height = Math.floor(rect.height);
          drawInitialEchogram();
        }
      }

      function drawEchogramColumn(x, w, h, phase) {
        if (!echoCtx) return;
        // Fond abyssal
        echoCtx.fillStyle = "#040910";
        echoCtx.fillRect(x, 0, 2, h);

        // Réverbération surface
        echoCtx.fillStyle = "rgba(0, 242, 254, 0.25)";
        echoCtx.fillRect(x, 4, 2, 3);

        // Thermocline à 16m (~34% hauteur)
        const thermY = h * 0.34 + Math.sin(phase * 0.08) * 2;
        if (Math.random() > 0.2) {
          echoCtx.fillStyle = "rgba(64, 220, 202, 0.55)";
          echoCtx.fillRect(x, thermY, 2, 1.5);
        }

        // Arches de poissons périodiques (bancs entre 55% et 72%)
        const archCycle = (phase % 110);
        if (archCycle > 25 && archCycle < 60) {
          const t = (archCycle - 42.5) / 17.5;
          const archY = h * 0.58 + t * t * 14;
          echoCtx.fillStyle = Math.abs(t) < 0.35 ? "#ffb4ab" : "#ffba38";
          echoCtx.fillRect(x, archY, 2, 4);
        }
        if (archCycle > 48 && archCycle < 78) {
          const t2 = (archCycle - 63) / 15;
          const archY2 = h * 0.66 + t2 * t2 * 11;
          echoCtx.fillStyle = "#ffd491";
          echoCtx.fillRect(x, archY2, 2, 3);
        }

        // Bruit planctonique léger
        if (Math.random() > 0.86) {
          echoCtx.fillStyle = "rgba(64, 220, 202, 0.35)";
          echoCtx.fillRect(x, 12 + Math.random() * (h * 0.65), 1.5, 1.5);
        }

        // Contour fond marin (~82% hauteur)
        const seabedY = h * 0.82 + Math.sin(phase * 0.05) * 3 + Math.cos(phase * 0.13) * 1.5;
        const grad = echoCtx.createLinearGradient(0, seabedY, 0, h);
        grad.addColorStop(0, "#ffd491");
        grad.addColorStop(0.2, "#ffba38");
        grad.addColorStop(0.55, "#ffb4ab");
        grad.addColorStop(1, "#93000a");
        echoCtx.fillStyle = grad;
        echoCtx.fillRect(x, seabedY, 2, h - seabedY);
      }

      function drawInitialEchogram() {
        if (!echoCtx || !echogramCanvas) return;
        const w = echogramCanvas.width;
        const h = echogramCanvas.height;
        for (let x = 0; x < w; x += 2) {
          echoPhase += 1;
          drawEchogramColumn(x, w, h, echoPhase);
        }
      }

      setInterval(() => {
        if (state.activeTab !== "carte-sonar" || !echoCtx || !echogramCanvas) return;
        const w = echogramCanvas.width;
