        if (w <= 4 || h <= 4) return;
        const imgData = echoCtx.getImageData(2, 0, w - 2, h);
        echoCtx.putImageData(imgData, 0, 0);
        echoPhase += 1;
        drawEchogramColumn(w - 2, w, h, echoPhase);
