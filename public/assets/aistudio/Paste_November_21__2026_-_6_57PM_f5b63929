      const measureOverlay = document.getElementById("measure-overlay");
      const mapSvg = document.getElementById("tactical-map-svg");

      btnMeasure.addEventListener("click", () => {
        state.measureActive = !state.measureActive;
        state.measurePoints = [];
        btnMeasure.classList.toggle("ring-2", state.measureActive);
        btnMeasure.classList.toggle("ring-primary-container", state.measureActive);
        btnMeasure.classList.toggle("text-primary-container", state.measureActive);
        measureBadge.classList.toggle("hidden", !state.measureActive);
        if (!state.measureActive) {
          measureOverlay.classList.add("hidden");
        } else {
          measureBadge.textContent = "Mode Règle : touchez 2 points sur la carte";
        }
      });

      mapSvg.addEventListener("click", (e) => {
        if (!state.measureActive) return;
        const rect = mapSvg.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 400;
        const y = ((e.clientY - rect.top) / rect.height) * 460;

        state.measurePoints.push({ x, y });
        if (state.measurePoints.length > 2) {
          state.measurePoints = [{ x, y }];
        }

        const p1 = state.measurePoints[0];
        const pt1El = document.getElementById("measure-pt1");
        const pt2El = document.getElementById("measure-pt2");
        const lineEl = document.getElementById("measure-line");

        measureOverlay.classList.remove("hidden");
        pt1El.setAttribute("cx", p1.x);
        pt1El.setAttribute("cy", p1.y);

        if (state.measurePoints.length === 1) {
          pt2El.setAttribute("cx", p1.x);
          pt2El.setAttribute("cy", p1.y);
          lineEl.setAttribute("x1", p1.x);
          lineEl.setAttribute("y1", p1.y);
          lineEl.setAttribute("x2", p1.x);
          lineEl.setAttribute("y2", p1.y);
          measureBadge.textContent = "Point A fixé — touchez le Point B";
